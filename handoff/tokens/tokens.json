{
  "name": "BT Smör specimen site",
  "colors": {
    "black":  { "value": "#0A0A0A", "use": "ink on yellow/white; page background for dark sections (Melt, Æ Ø Å, Tester, Specs)" },
    "yellow": { "value": "#FFD21F", "use": "page background for light-yellow sections (Hero, Features); text/lines on black; emphasis tier; slider markers" },
    "white":  { "value": "#FFFFFF", "use": "page background for white sections (Axes, Glyphs, In use, Licence); secondary text on black" },
    "guide-on-yellow":  { "value": "rgba(10,10,10,0.22)", "use": "12/8/4-column guide lines behind the Hero" },
    "row-line-on-black": { "value": "rgba(255,210,31,0.35)", "use": "body-row separators inside spec tables on black" }
  },
  "forbidden": ["orange/red (#FF4B1F)", "cobalt (#2335FF)", "pink (#FFB8D4)", "cream (#FFF5D6)", "drop shadows", "rounded cards", "gradients"],
  "fonts": {
    "display": { "family": "BT Smör", "fallback": "\"Arial Black\", Impact, system-ui, sans-serif", "file": "fonts/BTSmor.woff2" },
    "body":    { "family": "Familjen Grotesk", "source": "Google Fonts", "weights": [400, 500, 600, 700], "fallback": "system-ui, sans-serif" },
    "mono":    { "family": "DM Mono", "source": "Google Fonts", "weights": [400, 500], "fallback": "ui-monospace, monospace" }
  },
  "axes": {
    "MELT": { "name": "Meltiness", "min": 0, "default": 0,   "max": 100 },
    "BUBL": { "name": "Bubbles",   "min": 0, "default": 100, "max": 100 },
    "SLMP": { "name": "Slump",     "min": 0, "default": 100, "max": 100 }
  },
  "instances": {
    "Solid":       { "MELT": 0,   "BUBL": 100, "SLMP": 100 },
    "Soft":        { "MELT": 33,  "BUBL": 100, "SLMP": 100 },
    "Gooey":       { "MELT": 66,  "BUBL": 100, "SLMP": 100 },
    "Puddle":      { "MELT": 100, "BUBL": 100, "SLMP": 100 },
    "Calm Puddle": { "MELT": 100, "BUBL": 40,  "SLMP": 20 },
    "Hot Pan":     { "MELT": 100, "BUBL": 100, "SLMP": 0 }
  },
  "features": { "ss01": "Double-storey a (a å ä)", "ss02": "Square dots (i j ä ö Ä Ö . , : ; ! ?)" },
  "breakpoints": {
    "mobile":  { "design-width": 390,  "range": "< 640px",        "grid-columns": 4 },
    "tablet":  { "design-width": 768,  "range": "640px – 1023px", "grid-columns": 8 },
    "desktop": { "design-width": 1440, "range": ">= 1024px",       "grid-columns": 12 }
  },
  "layout": {
    "rule": "1px solid",
    "nav-height": 56,
    "gutter": { "desktop": 28, "tablet": 24, "mobile": 20 },
    "metadata-column": { "desktop": 220, "tablet": 190, "mobile": "stacked" }
  },
  "type-scale": {
    "label":        { "family": "mono", "size": 12, "tracking": "0.09em", "case": "uppercase", "weight": 400 },
    "label-small":  { "family": "mono", "size": 11, "tracking": "0.08em", "case": "uppercase" },
    "body":         { "family": "body", "size": [15, 20], "line-height": 1.4 },
    "h2":           { "family": "display", "size": { "desktop": 112, "tablet": 100, "mobile": [72, 100] }, "line-height": 1 },
    "hero-word":    { "family": "display", "size": { "desktop": 296, "tablet": 250, "mobile": 128 }, "note": "desktop one line 'BT Smör'; tablet/mobile stacked 'BT' over 'Smör'; line-height .92–.95" }
  },
  "font-metrics": { "unitsPerEm": 1000, "capHeight": 720, "xHeight": 540, "ascender": 760, "descender": -200, "hheaAscent": 950, "hheaDescent": -300 }
}
